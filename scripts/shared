###
#
# Script to be imported by every other executable script with
#   source "$(dirname "$0")/shared"
#
# This defines basic variables, shared functions and loads the configuration
#
###

# Fail on error
set -euo pipefail


#
# Constant definitions
#

# Base Colors
COLOR_RESET="\033[0;0m"
COLOR_BLACK="\033[0;30m"
COLOR_RED="\033[0;31m"
COLOR_GREEN="\033[0;32m"
COLOR_ORANGE="\033[0;33m"
COLOR_BLUE="\033[0;34m"
COLOR_PURPLE="\033[0;35m"
COLOR_CYAN="\033[0;36m"
COLOR_LIGHT_GRAY="\033[0;37m"
COLOR_DARK_GRAY="\033[1;30m"
COLOR_LIGHT_RED="\033[1;31m"
COLOR_LIGHT_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_LIGHT_BLUE="\033[1;34m"
COLOR_LIGHT_PURPLE="\033[1;35m"
COLOR_LIGHT_CYAN="\033[1;36m"
COLOR_WHITE="\033[1;37m"

# Semantic colors
COLOR_ERROR=${COLOR_RED}
COLOR_INFO=${COLOR_LIGHT_BLUE}
COLOR_NAME=${COLOR_GREEN}
COLOR_VERSION=${COLOR_GREEN}
COLOR_FILE=${COLOR_YELLOW}
COLOR_DIM=${COLOR_DARK_GRAY}
COLOR_TAG=${COLOR_PURPLE}
COLOR_VAR=${COLOR_CYAN}
COLOR_BIN=${COLOR_CYAN}

# Project root (in case scripts run from a different path)
if [ -n "${BASH_SOURCE:-}" ]; then
  # Bash: use BASH_SOURCE to get sourced script path
  this_path="${BASH_SOURCE[0]}"
else
  # POSIX: fall back to $0 (might fail if sourced from .githooks)
  this_path="$0"
fi
PROJECT_ROOT="$(realpath --relative-to "$(pwd)" "$(dirname "${this_path}")/..")"


# Load configuration
source "${PROJECT_ROOT}/scripts/config"


#
# Extended config (from other values)
#


# Main source file. Version is read from this file
VERSION_GD_FILE="${PLUGIN_FOLDER}/logger.gd"
# Plugin config, its version needs to match the one in VERSION_GD_FILE
PLUGIN_CONFIG_FILE="${PLUGIN_FOLDER}/plugin.cfg"
# Name of the plugin as set in the config file
PLUGIN_NAME=$(grep -E '^name=' "${PLUGIN_CONFIG_FILE}" | sed -E 's/name="([^"]+)"/\1/')
# Version of the plugin as set in VERSION_GD_FILE
PLUGIN_VERSION=$(grep -E '^const VERSION\s*=\s*"' "${VERSION_GD_FILE}" | sed -E "s/.*['\"]([^'\"]+)['\"].*/\\1/")
# Version of the plugin as set in PLUGIN_CONFIG_FILE
PLUGIN_CONFIG_VERSION=$(grep -E '^version\s*=' "${PLUGIN_CONFIG_FILE}" | sed -E "s/.*['\"]([^'\"]+)['\"].*/\\1/")


#
# Utilities
#

# Outputs an information message to stdout
info() {
  local msg="$@"
  echo -e "${COLOR_INFO}INFO: ${COLOR_RESET}${msg}"
}


# Exits failing the script with error code 1 (generic error)
# and outputting the error message to stderr
fail() {
  local msg="$@"
  echo -e "${COLOR_ERROR}ERROR: ${COLOR_RESET}${msg}"
  exit 1
}


# Output the path to the Godot executable or fail if not available (or inconsistent with the project
# version).
# It's searched in this order:
#   - The $GODOT environment variable (i.e. /x/path/to/Godot_v4.4-stable_win64.exe)
#   - `godotTools.editorPath.godot4` from .vscode/settings.json
#   - `godot` from $PATH
# The first one that is executable and returns a Godot version
# (i.e. `4.6.stable.official.89cea1439`) is used
# Its major.minor version must match the one in project.godot (i.e. `4.6`) or it will fail
# Usage: GODOT=$(require_godot) && "$GODOT" ...
require_godot() {
  local vscode_settings="${PROJECT_ROOT}/.vscode/settings.json"
  local vscode_godot=""
  local project_version=""
  local godot version

  # i.e. config/features=PackedStringArray("4.6", "Forward Plus")
  # Only major.minor is compared, so 4.6, 4.6.0 and 4.6.1 are all compatible
  project_version=$(sed -n -E 's/^config\/features\s*=\s*PackedStringArray\(\s*"([0-9]+\.[0-9]+)(\.[0-9]+)?".*/\1/p' \
    "${PROJECT_ROOT}/project.godot" | head -n 1)

  if [[ -f "${vscode_settings}" ]]; then
    # JSON escapes `\` as `\\`
    vscode_godot=$(sed -n -E 's/.*"godotTools\.editorPath\.godot4"\s*:\s*"([^"]+)".*/\1/p' "${vscode_settings}" \
      | head -n 1 | sed -E 's/\\\\/\//g')
  fi

  for godot in "${GODOT:-}" "${vscode_godot}" godot; do
    if [[ -n "${godot}" ]] \
      && command -v "${godot}" >/dev/null 2>&1 \
      && version=$("${godot}" --version 2>/dev/null | tr -d '\r') \
      && [[ "${version}" =~ ^[0-9]+\.[0-9]+[^[:space:]]*$ ]]; then
      info "Godot ${COLOR_VERSION}${version}${COLOR_RESET} detected at ${COLOR_FILE}${godot}${COLOR_RESET}" >&2

      # i.e. 4.6.stable.official.89cea1439 or 4.6.1.stable.official.14d19694e => 4.6
      if [[ -n "${project_version}" && "$(echo "${version}" | cut -d . -f 1-2)" != "${project_version}" ]]; then
        fail "Godot ${COLOR_VERSION}${version}${COLOR_RESET} doesn't match the project version" \
          "${COLOR_VERSION}${project_version}${COLOR_RESET} (${COLOR_FILE}project.godot${COLOR_RESET})" >&2
      fi

      echo "${godot}"
      return 0
    fi
  done

  fail "Godot can't be found. Set ${COLOR_VAR}\$GODOT${COLOR_RESET} to the Godot executable to use" >&2
}

# Output the command to run pip (i.e. `pip3`, `pip` or `python3 -m pip`)
# or fail if not available
# Usage: PIP=$(require_pip) && $PIP install ...
require_pip() {
  local cmd
  for cmd in pip3 pip; do
    if command -v "${cmd}" >/dev/null 2>&1; then
      echo "${cmd}"
      return 0
    fi
  done

  for cmd in python3 python; do
    if command -v "${cmd}" >/dev/null 2>&1 && "${cmd}" -m pip --version >/dev/null 2>&1; then
      echo "${cmd} -m pip"
      return 0
    fi
  done

  fail "pip can't be found" >&2
}

# Given the output of `pip show -f <package>` from stdin, output the full path
# of the executable named $1 installed by that package
# Returns 1 (without output) if not found
pip_show_find_bin() {
  local bin="$1"
  local output location file path

  # pip on Windows outputs CRLF line endings
  output=$(tr -d '\r')
  location=$(echo "${output}" | sed -n -E 's/^Location:\s*//p' | head -n 1)
  file=$(echo "${output}" | grep -E "^\s+.*[/\\\\]${bin}(\.exe)?$" | head -n 1 | sed -E 's/^\s+//')

  if [[ -z "${location}" || -z "${file}" ]]; then
    return 1
  fi

  path=$(echo "${location}/${file}" | tr '\\' '/')
  path=$(realpath "${path}" 2>/dev/null || echo "${path}")

  if [[ ! -x "${path}" ]]; then
    return 1
  fi

  echo "${path}"
}

# Output the path to the executable $1 provided by the gdtoolkit python package
# or fail if not available.
# First it's searched in $PATH (outputting just the name of the binary), and
# if not found, it's searched in the gdtoolkit package installed via pip or pipx
# Usage: GDLINT=$(require_gdtoolkit_bin gdlint) && "$GDLINT" ...
require_gdtoolkit_bin() {
  local bin="$1"
  local pip path

  if command -v "${bin}" >/dev/null 2>&1; then
    echo "${bin}"
    return 0
  fi

  # `pipx runpip <package>` is pip running inside the pipx venv of the package.
  # Missing pip/pipx is not an error here, as only one of them might be used
  for pip in "$(require_pip 2>/dev/null)" "pipx runpip gdtoolkit"; do
    if [[ -n "${pip}" ]] \
      && path=$(${pip} show -f gdtoolkit 2>/dev/null | pip_show_find_bin "${bin}"); then
      info "${bin} not found in ${COLOR_VAR}\$PATH${COLOR_RESET} but installed via ${COLOR_VAR}${pip}${COLOR_RESET}: ${COLOR_FILE}${path}${COLOR_RESET}" >&2
      echo "${path}"
      return 0
    fi
  done

  fail "${bin} can't be found" >&2
}

# Output the path to the gdlint executable or fail if not available
# Usage: GDLINT=$(require_gdlint) && "$GDLINT" ...
require_gdlint() {
  require_gdtoolkit_bin gdlint
}

# Output the path to the gdformat executable or fail if not available
# Usage: GDFORMAT=$(require_gdformat) && "$GDFORMAT" ...
require_gdformat() {
  require_gdtoolkit_bin gdformat
}

# Create a .zip on target path ($1) from the list specified in the
# file from the path ($2)
zip_files() {
  target=$1
  file_list_path=$2

  if [ -n "${SEVEN_ZIP:-}" ] && command -v "$SEVEN_ZIP" > /dev/null 2>&1; then
    # if 7z is available, use it
    "$SEVEN_ZIP" a "$target" @"${file_list_path}" | grep -E "(Add new data)|(Everything is Ok)"

  elif command -v "zip" > /dev/null 2>&1; then
    # if no 7z is available, fallback to the zip command
    zip -r "${target}" -@ < "${file_list_path}" > /dev/null

  else
    # if no 7z or zip are available, fail
    fail "No 7z nor zip commands are available"

  fi
}

# Return the tag of the current github environment variable
# Empty string if not found
get_github_tag() {
  local tagName="${GITHUB_REF:-}"
  tagName="${tagName#refs/tags/}"
  echo "${tagName}"
}
